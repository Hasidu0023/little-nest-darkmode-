<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DetailText">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#444</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AddStudentText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/editTextBackground</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="RoundImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- This is used in family/About section -->
    <style name="TabLayoutTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>


<!-- update student xml -->
    <!-- Style for the horizontal container holding the label and value -->
    <style name="ProfileItemContainer" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <!-- Style for the label (e.g., "Nickname") -->
    <style name="ProfileItemLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Style for the editable value (e.g., "hunny") -->
    <style name="ProfileItemValue" parent="android:Widget.EditText">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textColor">#808080</item>

        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center_vertical|end</item>
        <!-- Apply the new rounded background drawable -->
        <item name="android:background">@drawable/rounded_input_background</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:singleLine">true</item>
        <!-- Remove standard focus outline padding that interferes with the custom background -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Style for the divider line -->
    <style name="DividerLine" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#E0E0E0</item>
    </style>
</resources>