<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp"
    android:background="@android:color/white"
    tools:context=".ui.student.AddStudentFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PROFILE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/avatar_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Student Full Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@null"
                android:inputType="textPersonName|textCapWords" />
        </LinearLayout>


        <!-- ACCOUNT DETAILS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACCOUNT DETAILS"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="#555555"
            android:paddingBottom="8dp" />

        <!-- Username -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Username" />
            <EditText
                android:id="@+id/etUsername"
                style="@style/ProfileItemValue"
                android:hint="Enter username"
                android:inputType="textEmailAddress" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Password -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Password" />
            <EditText
                android:id="@+id/etPassword"
                style="@style/ProfileItemValue"
                android:hint="Enter password"
                android:inputType="textPassword" />
        </LinearLayout>


        <!-- PERSONAL DETAILS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAL DETAILS"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="#555555"
            android:paddingBottom="8dp"
            android:paddingTop="20dp"/>

        <!-- Group -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Group Name" />

            <Spinner
                android:id="@+id/spinnerGroup"
                style="@style/ProfileItemValue"
                android:layout_gravity="end"
                android:gravity="end" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Gender" />
            <Spinner
                android:id="@+id/spinnerGender"
                style="@style/ProfileItemValue"
                android:hint="Enter nickname"
                android:inputType="textPersonName"
                android:layout_gravity="end"
                android:gravity="end"/>
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Nickname -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Nickname" />
            <EditText
                android:id="@+id/etNickname"
                style="@style/ProfileItemValue"
                android:hint="Enter nickname"
                android:inputType="textPersonName" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Date of Birth (Non-editable for selection) -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Date of Birth" />
            <EditText
                android:id="@+id/etDateOfBirth"
                style="@style/ProfileItemValue"
                android:hint="dd-MM-yyyy"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Dropoff Time (Non-editable for selection) -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Dropoff Time" />
            <EditText
                android:id="@+id/etDropOffTime"
                style="@style/ProfileItemValue"
                android:hint="HH:mm"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Pickup Time (Non-editable for selection) -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Pickup Time" />
            <EditText
                android:id="@+id/etPickupTime"
                style="@style/ProfileItemValue"
                android:hint="HH:mm"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Address -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Address" />
            <EditText
                android:id="@+id/etAddress"
                style="@style/ProfileItemValue"
                android:hint="Enter address"
                android:inputType="textPostalAddress" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- City -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="City" />
            <EditText
                android:id="@+id/etCity"
                style="@style/ProfileItemValue"
                android:hint="Enter city"
                android:inputType="text" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Allergies -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Allergies" />
            <EditText
                android:id="@+id/etAllergies"
                style="@style/ProfileItemValue"
                android:hint="Enter allergies"
                android:inputType="text" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Language -->
        <LinearLayout
            style="@style/ProfileItemContainer">
            <TextView
                style="@style/ProfileItemLabel"
                android:text="Native Language" />
            <EditText
                android:id="@+id/etLanguage"
                style="@style/ProfileItemValue"
                android:hint="Enter language"
                android:inputType="text" />
        </LinearLayout>
        <View style="@style/DividerLine" />

        <!-- Photo Consent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Photo Consent"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cbPhotoConsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Comment (Uses MultiLine Input) -->
        <!-- Note: This is an exception, keeping it full-width for multi-line input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comment"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter comment or special instructions"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:paddingVertical="8dp"
            android:background="@drawable/rounded_edittext_background"
            android:paddingLeft="10dp"
            android:layout_marginBottom="24dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Student"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/kindiedays_blue_dark"
            android:layout_marginTop="24dp"
            android:paddingVertical="12dp" />

    </LinearLayout>
</ScrollView>


