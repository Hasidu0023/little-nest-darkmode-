<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Solid color for the selected state (Light Teal/Green) -->
    <solid android:color="#B2DFDB" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Optional padding for better visual alignment -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="8dp"
        android:bottom="8dp" />
</shape>
